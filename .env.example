# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# ----- DIRECT ANTHROPIC AUTHENTICATION -----
# Configure this value only in your private .env file or shell environment.
# Never commit a real API key.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL must remain unset when using direct Anthropic access.
# ----- AWS BEDROCK ALTERNATIVE -----
# Enable Bedrock and configure all required AWS values.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1
# ----- MODEL -----
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
REVIEW_MAX_TURNS=80
REVIEW_MAX_BUDGET_USD=1.25
PROJECT_ROOT=/absolute/path/to/claude-code-multi-agent-orchestrator
# GITHUB_TOKEN=ghp_your-token-here
LOG_LEVEL=info

# ----- GITHUB -----
# Recommended for higher rate limits and private repository access.
# Required scopes: repo and read:org.
# GITHUB_TOKEN=ghp_your-token-here
# ----- LOGGING -----
# Options: error, warn, info, debug.
