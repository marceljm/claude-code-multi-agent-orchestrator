# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# ----- UDACITY VOCAREUM AUTHENTICATION -----
# Add the API key provided by Udacity to your private .env file.
# ANTHROPIC_API_KEY=<your-udacity-api-key>
ANTHROPIC_BASE_URL=https://claude.vocareum.com
# ----- DIRECT ANTHROPIC ALTERNATIVE -----
# When using your own Anthropic API key:
# 1. Set ANTHROPIC_API_KEY to your personal key.
# 2. Remove or comment out ANTHROPIC_BASE_URL.
# ----- AWS BEDROCK ALTERNATIVE -----
# Enable Bedrock and configure all required AWS values.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1
# ----- MODEL -----
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
REVIEW_MAX_TURNS=80
REVIEW_MAX_BUDGET_USD=1.25
PROJECT_ROOT=/absolute/path/to/claude-code-multi-agent-orchestrator
# GITHUB_TOKEN=ghp_your-token-here
LOG_LEVEL=info

# ----- GITHUB -----
# Recommended for higher rate limits and private repository access.
# Required scopes: repo and read:org.
# GITHUB_TOKEN=ghp_your-token-here
# ----- LOGGING -----
# Options: error, warn, info, debug.
