# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================

# ----- AUTHENTICATION -----
# For direct Anthropic API access, configure a private API key locally:
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# For AWS Bedrock authentication, enable Bedrock explicitly and configure all
# three AWS values in your environment (do not commit real credentials):
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1

# ----- MODEL CONFIGURATION (REQUIRED) -----
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Available models:
#   - claude-haiku-4-5-20251001 (configured)

# ----- REVIEW SAFEGUARDS -----
REVIEW_MAX_TURNS=80
REVIEW_MAX_BUDGET_USD=1.25

# ----- PROJECT ROOT (REQUIRED) -----
# Absolute path to the project/starter directory
# This directory MUST contain the .claude/skills/ directory

# Vocareum workspace:
PROJECT_ROOT=/voc/work/cd14715-claude-code-classroom/project/starter

# Local development (update to your path):
# PROJECT_ROOT=/absolute/path/to/project/starter

# ----- GITHUB TOKEN (RECOMMENDED) -----
# For higher rate limits and private repository access
# Generate at: https://github.com/settings/tokens
# Required scopes: 'repo', 'read:org'
# GITHUB_TOKEN=ghp_your-token-here

# ----- LOGGING (OPTIONAL) -----
# Options: error, warn, info, debug
LOG_LEVEL=info
